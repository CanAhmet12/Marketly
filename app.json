{
  "expo": {
    "name": "Marketly",
    "slug": "Marketly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#00C853"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.marketly.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Canlı yayın için kamera gereklidir.",
        "NSMicrophoneUsageDescription": "Canlı yayın için mikrofon gereklidir.",
        "NSPhotoLibraryUsageDescription": "Video ve fotoğraf yüklemek için galeri erişimi gereklidir."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#00C853",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.marketly.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Video ve fotoğraf yüklemek için galeri erişimi gereklidir.",
          "cameraPermission": "Profil fotoğrafı çekmek için kamera gereklidir."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#00C853"
        }
      ],
      "expo-secure-store",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "bb3ee77c-fd0e-4ecf-8a1f-8d09b5b7f9c2"
      }
    }
  }
}
