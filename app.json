{
  "expo": {
    "name": "Marketly",
    "slug": "Marketly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "marketly",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#00C853"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.marketly.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Canlı yayın için kamera gereklidir.",
        "NSMicrophoneUsageDescription": "Canlı yayın için mikrofon gereklidir.",
        "NSPhotoLibraryUsageDescription": "Video ve fotoğraf yüklemek için galeri erişimi gereklidir.",
        "NSUserTrackingUsageDescription": "İlgili içerikleri göstermek için kullanılır.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1"]
          }
        ],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyTracking": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#00C853",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.marketly.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "newArchEnabled": true,
    "plugins": [
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Video ve fotoğraf yüklemek için galeri erişimi gereklidir.",
          "cameraPermission": "Profil fotoğrafı çekmek için kamera gereklidir."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#00C853"
        }
      ],
      "expo-secure-store",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "BURAYA_EAS_INIT_SONRASI_GELEN_ID_YAZILACAK"
      }
    },
    "owner": "BURAYA_EXPO_KULLANICI_ADIN_YAZILACAK"
  }
}
